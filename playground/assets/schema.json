{
  "title": "Questioneer",
  "description": "Questioneer for tennis camp 'name'",
  "renderer": "MultiStage",
  "type": "object",
  "required": [
    "personal",
    "permissions",
    "clothing",
    "dietary",
    "firstname"
  ],
  "properties": {
    "personal": {
      "icon": "i-lucide-user",
      "title": "Personal",
      "type": "object",
      "required": [
        "firstname",
        "lastname",
        "email"
      ],
      "properties": {
        "firstname": {
          "title": "Firstname",
          "description": "First name pertisipant",
          "type": "string",
          "default": ""
        },
        "lastname": {
          "title": "Lastname",
          "description": "Last name pertisipant",
          "type": "string",
          "default": ""
        },
        "email": {
          "title": "Email",
          "description": "Last name pertisipant",
          "type": "string",
          "format": "email",
          "default": ""
        }
      }
    },
    "permissions": {
      "icon": "i-lucide-lock",
      "title": "Terms",
      "type": "object",
      "required": [
        "agree"
      ],
      "properties": {
        "agree": {
          "title": "Agree",
          "description": "Accept all term",
          "type": "boolean"
        }
      }
    },
    "clothing": {
      "icon": "i-lucide-shirt",
      "title": "Clothing",
      "type": "object",
      "required": [
        "tshirtSize"
      ],
      "properties": {
        "tshirtSize": {
          "title": "T-shirt size",
          "renderer": "SSelect",
          "description": "T-shirt size",
          "enum": [
            "s",
            "m",
            "l",
            "xl"
          ],
          "type": "string"
        }
      }
    },
    "dietary": {
      "icon": "i-lucide-apple",
      "title": "Dietary",
      "type": "object",
      "required": [
        "vegetarian",
        "vegan",
        "halal",
        "nutAllergy"
      ],
      "properties": {
        "vegetarian": {
          "title": "Vegetarian",
          "description": "Vegetarian dietary restrictions",
          "type": "boolean"
        },
        "vegan": {
          "title": "Vegan",
          "description": "Vegan dietary restrictions",
          "type": "boolean"
        },
        "halal": {
          "title": "Halal",
          "description": "Halal dietary restrictions",
          "type": "boolean"
        },
        "nutAllergy": {
          "title": "Nut Allergy",
          "description": "Nut allergy",
          "type": "boolean"
        }
      }
    }
  }
}
