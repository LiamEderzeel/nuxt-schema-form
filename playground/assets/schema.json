{
  "title": "Questioneer",
  "description": "Questioneer for tennis camp 'name'",
  "type": "object",
  "required": [
    "participant",
    "guardian",
    "permissions",
    "misc"
  ],
  "renderer": "MultiStage",
  "properties": {
    "participant": {
      "title": "Deelnemer",
      "icon": "lucide:user",
      "type": "object",
      "required": [
        "flex",
        "birthDate",
        "tshirtSize",
        "tennisLevel",
        "swimmingLevel",
        "health"
      ],
      "properties": {
        "flex": {
          "required": [
            "firstname",
            "lastname"
          ],
          "type": "object",
          "renderer": "SRow",
          "properties": {
            "firstname": {
              "title": "Firstname",
              "description": "First name pertisipant",
              "type": "string",
              "default": ""
            },
            "lastname": {
              "title": "Lastname",
              "description": "Last name pertisipant",
              "type": "string",
              "default": ""
            }
          }
        },
        "birthDate": {
          "title": "Geboorte datum",
          "format": "date-time",
          "default": "2000-01-01T00:00:00.000Z",
          "type": "string"
        },
        "tshirtSize": {
          "title": "T-shirt size",
          "renderer": "SSelect",
          "description": "T-shirt size",
          "enum": [
            "s",
            "m",
            "l",
            "xl"
          ],
          "type": "string"
        },
        "tennisLevel": {
          "title": "Tennisniveau",
          "renderer": "SSelect",
          "description": "Het niveau van de deelnemer",
          "enum": [
            "red",
            "orange",
            "green",
            "yellow",
            "other"
          ],
          "type": "string"
        },
        "swimmingLevel": {
          "title": "Zwemdiploma",
          "renderer": "SSelect",
          "description": "Het zwemdiploma van de deelnemer",
          "enum": [
            "a",
            "b",
            "c",
            "geen"
          ],
          "type": "string"
        },
        "health": {
          "title": "Voedsel allergieën of gezondheid",
          "renderer": "STextarea",
          "description": "Zijn er bijzonderheden waar we rekening mee moeten houden betreffende voedsel allergieën en/of informatie over de gezondheid?",
          "type": "string"
        }
      }
    },
    "guardian": {
      "title": "Voogd",
      "icon": "lucide:users",
      "type": "object",
      "required": [
        "flex"
      ],
      "properties": {
        "flex": {
          "required": [
            "firstname",
            "lastname"
          ],
          "type": "object",
          "renderer": "SRow",
          "properties": {
            "firstname": {
              "title": "Firstname",
              "description": "First name pertisipant",
              "type": "string",
              "default": ""
            },
            "lastname": {
              "title": "Lastname",
              "description": "Last name pertisipant",
              "type": "string",
              "default": ""
            }
          }
        },
        "email": {
          "title": "Email",
          "description": "Last name pertisipant",
          "type": "string",
          "format": "email",
          "default": ""
        },
        "phoneNumber": {
          "title": "Telefoon nummber",
          "description": "Telefoon nummer voor contact of noodgevallen",
          "type": "string",
          "format": "email",
          "default": ""
        },
        "emergencyNumber": {
          "title": "Extra nood nummer",
          "description": "Telefoon nummer om te bellen bij nood",
          "type": "string",
          "format": "email",
          "default": ""
        },
        "address": {
          "type": "object",
          "renderer": "Address",
          "required": [
            "street",
            "number",
            "zipCode",
            "city"
          ],
          "properties": {
            "street": {
              "title": "Straat",
              "type": "string"
            },
            "number": {
              "title": "Huisnummer",
              "type": "string"
            },
            "unit": {
              "title": "Toevoeging",
              "type": "string"
            },
            "zipCode": {
              "title": "Postcode",
              "type": "string"
            },
            "city": {
              "title": "Stad",
              "type": "string"
            }
          }
        }
      }
    },
    "permissions": {
      "title": "Toestemmig",
      "type": "object",
      "required": [
        "permissions"
      ],
      "properties": {
        "permissions": {
          "title": "Toestemming",
          "description": "Door middel van het aanvinken van onderstaande selectiebox, geef hierbij toestemming voor de vastlegging en de weergave van mijn naam, beeltenis en afbeelding verbonden aan mijn persoon, in foto&#39;s, beelden, of audiovisuele opnamen gemaakt, alsook in publiciteit over de onderneming.",
          "const": false,
          "type": "boolean"
        },
        "questions": {
          "title": "Vragen",
          "renderer": "STextarea",
          "description": "Overige opmerkingen/bijzonderheden/vragen?",
          "type": "string"
        },
        "found": {
          "title": "Hoe bent u erachter gekomen dat er een kamp was:",
          "renderer": "SSelect",
          "enum": [
            "trainer",
            "website",
            "mouthToMouth",
            "socialMedia",
            "other"
          ],
          "type": "string"
        }
      }
    }
  }
}
