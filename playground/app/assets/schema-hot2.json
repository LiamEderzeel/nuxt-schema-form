{
  "description": "Questionnaire for tennis camp 'name'",
  "type": "object",
  "required": [
    "participant",
    "guardian",
    "misc"
  ],
  "renderer": "MultiStage",
  "properties": {
    "participant": {
      "title": "Participant",
      "icon": "lucide:user",
      "type": "object",
      "required": [
        "firstname",
        "lastname",
        "birthDate",
        "swimmingLevel",
        "associationNumber"
      ],
      "layout": [
        [
          "firstname",
          "lastname"
        ]
      ],
      "properties": {
        "firstname": {
          "title": "First name",
          "description": "Participant's first name",
          "type": "string",
          "minimum": 1,
          "maxLength": 2
        },
        "lastname": {
          "title": "Last name",
          "description": "Participant's last name",
          "type": "string",
          "minLength": 1
        },
        "birthDate": {
          "title": "Date of birth",
          "format": "full-date",
          "default": "2000-01-01",
          "type": "string"
        },
        "associationNumber": {
          "title": "Membership number",
          "type": "string"
        },
        "swimmingLevel": {
          "title": "Swimming certificate",
          "renderer": "SSelect",
          "description": "The participant's swimming certificate",
          "enum": [
            "a",
            "b",
            "c",
            "none"
          ],
          "type": "string"
        },
        "health": {
          "title": "Food allergies or health",
          "renderer": "STextarea",
          "description": "Is there anything we should know about food allergies or health?",
          "type": "string"
        }
      }
    },
    "guardian": {
      "title": "Guardian",
      "icon": "lucide:users",
      "type": "object",
      "required": [
        "firstname",
        "lastname",
        "email",
        "phoneNumber",
        "address"
      ],
      "layout": [
        [
          "firstname",
          "lastname"
        ]
      ],
      "properties": {
        "firstname": {
          "title": "First name",
          "description": "Guardian's first name",
          "type": "string"
        },
        "lastname": {
          "title": "Lastname",
          "description": "Guardian's last name",
          "type": "string"
        },
        "email": {
          "title": "Email",
          "description": "Guardian's email address",
          "type": "string",
          "format": "email"
        },
        "phoneNumber": {
          "title": "Phone number",
          "description": "Phone number for contact or emergencies",
          "type": "string"
        },
        "emergencyNumber": {
          "title": "Extra emergency number",
          "description": "Phone number to call in an emergency",
          "type": "string"
        },
        "address": {
          "type": "object",
          "renderer": "Address",
          "required": [
            "street",
            "number",
            "zipCode",
            "city"
          ],
          "properties": {
            "street": {
              "title": "Street",
              "type": "string"
            },
            "number": {
              "title": "House number",
              "type": "string"
            },
            "unit": {
              "title": "Unit",
              "type": "string"
            },
            "zipCode": {
              "title": "Postal code",
              "type": "string"
            },
            "city": {
              "title": "City",
              "type": "string"
            }
          }
        }
      }
    },
    "misc": {
      "title": "Registration",
      "type": "object",
      "required": [
        "sleep",
        "dubbelPartner",
        "permission",
        "found"
      ],
      "properties": {
        "sleep": {
          "title": "Overnight stay",
          "description": "Staying at the tent camp is a fun and educational experience, and we hope you'll join us in the tents. You can also choose to sleep at home: you'll be picked up after the matches or the evening activity, and we expect you back at training the next day after breakfast at 8:00. Let us know what you prefer:",
          "type": "string",
          "renderer": "SSelect",
          "enum": [
            "sleepAtHome",
            "sleepAtCamp"
          ],
          "enum_titles": [
            "I'll sleep at the tent camp",
            "I'll sleep at home"
          ]
        },
        "tent": {
          "title": "Tent",
          "description": "If you chose to stay at the tent camp above, let us know below whether you are bringing your own tent.",
          "type": "string",
          "renderer": "SSelect",
          "enum": [
            "yes",
            "no"
          ],
          "enum_titles": [
            "Yes, I'm bringing my own tent",
            "No, I don't have my own tent"
          ]
        },
        "tentAmount": {
          "title": "Quantity",
          "description": "I'm bringing my own tent, and it fits this many children:",
          "type": "string",
          "renderer": "SSelect",
          "enum": [
            "1",
            "2",
            "3",
            "4"
          ],
          "enum_titles": [
            "Just me (1 person)",
            "2 people",
            "3 people",
            "4 people"
          ]
        },
        "tentPref": {
          "title": "Tent mates",
          "description": "If you chose to stay at the tent camp above, tell us below who you would like to share a tent with. Each tent sleeps about 3 or 4 people.",
          "type": "string"
        },
        "dubbelPartner": {
          "title": "Who would you like to play doubles with?",
          "description": "Please enter a first and last name.",
          "type": "string"
        },
        "permission": {
          "title": "Permission",
          "description": "By checking the box below, I give permission for my name and likeness to be recorded and shown in photos, videos or other recordings, and in publicity about the organization.",
          "const": false,
          "enum": [
            false
          ],
          "type": "boolean"
        },
        "found": {
          "title": "How did you hear about the camp?",
          "renderer": "SSelect",
          "enum": [
            "trainer",
            "website",
            "mouthToMouth",
            "socialMedia",
            "other"
          ],
          "type": "string"
        },
        "questions": {
          "title": "Questions",
          "renderer": "STextarea",
          "description": "Any other comments or questions?",
          "type": "string"
        }
      }
    }
  }
}
