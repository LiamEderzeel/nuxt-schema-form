          "enum": [
            "trainer",
            "website",
            "mouthToMouth",
            "socialMedia",
            "other"
          ],
          "type": "string"
        },
        "questions": {
          "title": "Questions",
          "renderer": "STextarea",
          "description": "Any other comments or questions?",
          "type": "string"
        },
        "name": {
          "title": "name",
          "type": "string"
        }
      }
