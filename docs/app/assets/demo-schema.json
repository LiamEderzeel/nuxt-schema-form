{
  "title": "Questionnaire",
  "description": "Questionnaire for tennis camp 'name'",
  "type": "object",
  "required": [
    "participant",
    "guardian",
    "misc"
  ],
  "renderer": "MultiStage",
  "properties": {
    "participant": {
      "title": "Participant",
      "icon": "lucide:user",
      "type": "object",
      "required": [
        "firstname",
        "lastname",
        "birthDate",
        "tshirtSize",
        "tennisLevel",
        "swimmingLevel"
      ],
      "layout": [
        [
          "firstname",
          "lastname"
        ]
      ],
      "properties": {
        "firstname": {
          "title": "First name",
          "description": "Participant's first name",
          "type": "string",
          "default": ""
        },
        "lastname": {
          "title": "Last name",
          "description": "Participant's last name",
          "type": "string",
          "default": ""
        },
        "birthDate": {
          "title": "Date of birth",
          "format": "full-date",
          "default": "2000-01-01",
          "type": "string"
        },
        "tshirtSize": {
          "title": "T-shirt size",
          "renderer": "SSelect",
          "enum": [
            "s",
            "m",
            "l",
            "xl"
          ],
          "type": "string"
        },
        "tennisLevel": {
          "title": "Tennis level",
          "renderer": "SSelect",
          "description": "The participant's level",
          "enum": [
            "red",
            "orange",
            "green",
            "yellow",
            "other"
          ],
          "enum_titles": [
            "red",
            "orange",
            "green",
            "yellow",
            "other"
          ],
          "type": "string"
        },
        "swimmingLevel": {
          "title": "Swimming certificate",
          "renderer": "SSelect",
          "description": "The participant's swimming certificate",
          "enum": [
            "a",
            "b",
            "c",
            "none"
          ],
          "type": "string"
        },
        "health": {
          "title": "Food allergies or health",
          "renderer": "STextarea",
          "description": "Is there anything we should know about food allergies or health?",
          "type": "string"
        }
      }
    },
    "guardian": {
      "title": "Guardian",
      "icon": "lucide:users",
      "type": "object",
      "required": [
        "firstname",
        "lastname",
        "email",
        "phoneNumber",
        "emergencyNumber",
        "address"
      ],
      "layout": [
        [
          "firstname",
          "lastname"
        ]
      ],
      "properties": {
        "firstname": {
          "title": "First name",
          "description": "Guardian's first name",
          "type": "string",
          "default": ""
        },
        "lastname": {
          "title": "Lastname",
          "description": "Guardian's last name",
          "type": "string",
          "default": ""
        },
        "email": {
          "title": "Email",
          "description": "Guardian's email address",
          "type": "string",
          "format": "email",
          "default": ""
        },
        "phoneNumber": {
          "title": "Phone number",
          "description": "Phone number for contact or emergencies",
          "type": "string",
          "default": ""
        },
        "emergencyNumber": {
          "title": "Extra emergency number",
          "description": "Phone number to call in an emergency",
          "type": "string",
          "default": ""
        },
        "address": {
          "type": "object",
          "renderer": "Address",
          "required": [
            "street",
            "number",
            "zipCode",
            "city"
          ],
          "properties": {
            "street": {
              "title": "Street",
              "type": "string"
            },
            "number": {
              "title": "House number",
              "type": "string"
            },
            "unit": {
              "title": "Unit",
              "type": "string"
            },
            "zipCode": {
              "title": "Postal code",
              "type": "string"
            },
            "city": {
              "title": "City",
              "type": "string"
            }
          }
        }
      }
    },
    "misc": {
      "title": "Registration",
      "type": "object",
      "required": [
        "permission",
        "found"
      ],
      "properties": {
        "permission": {
          "title": "Permission",
          "description": "By checking the box below, I give permission for my name and likeness to be recorded and shown in photos, videos or other recordings, and in publicity about the organization.",
          "const": false,
          "enum": [
            false
          ],
          "type": "boolean"
        },
        "found": {
          "title": "How did you hear about the camp?",
          "renderer": "SSelect",
          "enum": [
            "trainer",
            "website",
            "mouthToMouth",
            "socialMedia",
            "other"
          ],
          "type": "string"
        },
        "questions": {
          "title": "Questions",
          "renderer": "STextarea",
          "description": "Any other comments or questions?",
          "type": "string"
        }
      }
    }
  }
}
